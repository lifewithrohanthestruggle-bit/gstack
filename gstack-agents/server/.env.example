# ================================================================
# GStack Agents — server config
# ही फाईल copy करून .env बनवा:  cp .env.example .env
# एकही key नसताना system काम करते (Offline Demo mode मध्ये)
# ================================================================

# --- Server ---
PORT=8787
HOST=0.0.0.0

# --- Auth (optional, MVP) ---
# वर व्हॅल्यू ठेवली की सगळ्या /api रिक्वेस्टना Bearer token लागेल
# AUTH_TOKEN=my-secret-token

# --- Provider 1: Grok (xAI) — https://console.x.ai ---
# XAI_API_KEY=xai-xxxxxxxxxxxxxxxx
# XAI_MODEL=grok-4.5        (इतर पर्याय: grok-4.6, grok-4.20-multi-agent, grok-code-fast-1)
# XAI_BASE_URL=https://api.x.ai/v1

# --- Provider 2: Ollama (free, local, open-source models) ---
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:7b

# --- Tuning ---
MOCK_DELAY_MS=14
RUN_TIMEOUT_MS=240000
DATA_DIR=./data
